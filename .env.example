# Copy to .env and edit.
DORAEMON_TIMEZONE=Asia/Singapore
DORAEMON_HOME_CURRENCY=SGD
# How to read numeric dates like 02/10/26: DMY (2 Oct) or MDY (Feb 10)
DORAEMON_DATE_ORDER=DMY
# backend:model — e.g. ollama:qwen3:4b, ollama:gemma3:4b
DORAEMON_MODEL=ollama:qwen3.5:4b
OLLAMA_URL=http://localhost:11434
# Your addresses (comma-separated); forwarded receipts count only if originally sent to you
DORAEMON_USER_EMAILS=you@example.com
# Convert overseas spending to DORAEMON_HOME_CURRENCY with ECB rates (only currency+date are sent); "off" to disable
DORAEMON_CONVERT_CURRENCIES=on
# Telegram bot for reminders (bills, deadlines, deliveries, RSVPs): get a token from @BotFather,
# then run python -m doraemon.telegram connect and message the bot once
DORAEMON_TELEGRAM_TOKEN=
# Dorae-2's daily briefing in its chat (today, tomorrow, bills, trips); "off" to turn it off
DORAEMON_BRIEFING_TIME=08:00
# Also send the briefing to Telegram ("off" for the web app only)
DORAEMON_BRIEFING_TELEGRAM=on
# Keep reminding every few hours (9am-10pm) until you press Done on Telegram; "off" for the planned reminders only
DORAEMON_REMIND_UNTIL_DONE=on
# Dismiss suggestions still waiting for your OK a day after their date (undo under Activity); "off" keeps them
DORAEMON_EXPIRE_PASSED=on
# Start Ollama (ollama serve, no window) when the model is needed and it isn't running; "off" to leave it to you
DORAEMON_START_OLLAMA=on
# Answer everyday questions ("how much did I spend this week", "my reminders") from the data without the model; "off" to always use the model
DORAEMON_FAST_ANSWERS=on
# Webull SG brokerage linking for net worth (read-only use). Apply for OpenAPI access in Webull, then:
# pip install -e ".[webull]"
DORAEMON_WEBULL_APP_KEY=
DORAEMON_WEBULL_APP_SECRET=
